      "widgetBorderColor": {"light": "#FFFFFF", "dark": "#11171C"},
      "fontColor": {"light": "#11171C", "dark": "#E8ECF0"},
      "selectionColor": {"light": "#B4762C", "dark": "#E0A458"},
      "visualizationColors": [
        "#003F5C", "#594E90", "#BC4C96", "#FF5F66", "#FFA600", "#4E8CC7", "#6DD980", "#F0E09E"
      ],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}
